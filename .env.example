# Postgres connection string (Supabase, Neon, local, whatever)
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-min-32-chars-xxxxxxxxxxxxxxxxxx"

# Public app URL (used by Better Auth + Eden client base URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gemini API key — embeddings + knowledge-graph extraction (aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Notion integration (org-scoped OAuth) — optional, create a Public
# integration at https://www.notion.so/my-integrations, redirect URI:
# <NEXT_PUBLIC_APP_URL>/api/v1/notion/callback
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Microsoft 365 integration (org-scoped delegated OAuth) — optional, register an
# app in Entra (https://entra.microsoft.com) with delegated Graph scopes
# "offline_access User.Read Sites.Read.All Team.ReadBasic.All
#  Channel.ReadBasic.All ChannelMessage.Read.All", redirect URI:
# <NEXT_PUBLIC_APP_URL>/api/v1/microsoft/callback
# TENANT_ID may be a tenant GUID or "organizations" for multi-tenant apps.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Encrypts stored integration tokens at rest — generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
