# Postgres connection string (Supabase, Neon, local, whatever)
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-min-32-chars-xxxxxxxxxxxxxxxxxx"

# Public app URL (used by Better Auth + Eden client base URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gemini API key — embeddings + knowledge-graph extraction (aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Notion integration (org-scoped OAuth) — optional, create a Public
# integration at https://www.notion.so/my-integrations, redirect URI:
# <NEXT_PUBLIC_APP_URL>/api/v1/notion/callback
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# Encrypts stored Notion tokens at rest — generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# Slack integration — same app for both:
# 1) personal account linking (Sign in with Slack / OpenID Connect, scopes
#    openid/email/profile), redirect URL:
#    <NEXT_PUBLIC_APP_URL>/api/v1/slack/callback
# 2) org-wide bot install (channel monitoring), redirect URL:
#    <NEXT_PUBLIC_APP_URL>/api/v1/slack/workspace/callback
# Create the app at https://api.slack.com/apps.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""

# Verifies incoming Events API webhook requests (bot channel monitoring) —
# from the same Slack app, under "Basic Information" > "App Credentials" >
# "Signing Secret". The Events API needs a public HTTPS URL, so testing it
# locally requires a tunnel (ngrok etc.) pointed at this app.
SLACK_SIGNING_SECRET=""
